# Builds the installer, which the arm9 part of the parasite places in the ITCM. The real Pico Loader jumps to it
# instead of to the game; it hooks the game for the cheat menu and then starts the game (see installer/installer.cpp).
# The installer is linked at its final address in the ITCM.

.DEFAULT_GOAL := all

export BLOCKSDS			?= /opt/blocksds/core
export WONDERFUL_TOOLCHAIN	?= /opt/wonderful
ARM_NONE_EABI_PATH	?= $(WONDERFUL_TOOLCHAIN)/toolchain/gcc-arm-none-eabi/bin/

PREFIX		:= $(ARM_NONE_EABI_PATH)arm-none-eabi-
CC			:= $(PREFIX)gcc
CXX			:= $(PREFIX)g++
OBJCOPY		:= $(PREFIX)objcopy

SOURCEDIR	:= installer
BUILDDIR	:= build/installer
ELF			:= $(BUILDDIR)/installer.elf
MAP			:= $(BUILDDIR)/installer.map
BIN			:= arm9/data/installer.bin
LDSCRIPT	:= $(SOURCEDIR)/installer.ld

OBJS		:= $(BUILDDIR)/entry.s.o $(BUILDDIR)/installer.cpp.o
DEPS		:= $(OBJS:.o=.d)

FLAGS		:= -mthumb -mthumb-interwork -Os -mcpu=arm946e-s -Wall -ffreestanding -fno-builtin -fno-exceptions \
			   -fno-unwind-tables -fno-asynchronous-unwind-tables -ffunction-sections -fdata-sections \
			   -Icommon -I$(BLOCKSDS)/libs/libnds/include
CXXFLAGS	:= $(FLAGS) -std=gnu++23 -fno-rtti
LDFLAGS		:= -mcpu=arm946e-s -nostdlib -Wl,--gc-sections,--use-blx,--no-warn-rwx-segments,-Map,$(MAP) \
			   -T $(LDSCRIPT)

V := @

.PHONY: all clean

all: $(BIN)

$(BIN): $(ELF)
	@echo "  OBJCOPY $@"
	@mkdir -p $(@D)
	$(V)$(OBJCOPY) -O binary -j .text $< $@

$(ELF): $(OBJS) $(LDSCRIPT)
	@echo "  LD      $@"
	$(V)$(CC) -o $@ $(OBJS) $(LDFLAGS) -lgcc

$(BUILDDIR)/%.s.o: $(SOURCEDIR)/%.s
	@echo "  AS      $<"
	@mkdir -p $(@D)
	$(V)$(CC) $(FLAGS) -c -o $@ $<

$(BUILDDIR)/%.cpp.o: $(SOURCEDIR)/%.cpp
	@echo "  CXX     $<"
	@mkdir -p $(@D)
	$(V)$(CXX) $(CXXFLAGS) -MMD -MP -c -o $@ $<

clean:
	$(V)rm -rf $(BUILDDIR) $(BIN)

-include $(DEPS)
