# Builds the position independent resident part of the cheat menu that is embedded in picoLoader7.
.DEFAULT_GOAL := all

export BLOCKSDS			?= /opt/blocksds/core
export WONDERFUL_TOOLCHAIN	?= /opt/wonderful
ARM_NONE_EABI_PATH	?= $(WONDERFUL_TOOLCHAIN)/toolchain/gcc-arm-none-eabi/bin/

PREFIX		:= $(ARM_NONE_EABI_PATH)arm-none-eabi-
CC			:= $(PREFIX)gcc
OBJCOPY		:= $(PREFIX)objcopy
READELF		:= $(PREFIX)readelf
NM			:= $(PREFIX)nm

SOURCEDIR	:= resident
BUILDDIR	:= build/resident
ELF			:= $(BUILDDIR)/resident.elf
BIN			:= arm7/data/resident.bin

SOURCES		:= $(SOURCEDIR)/entry.s $(SOURCEDIR)/resident.c
OBJS		:= $(patsubst $(SOURCEDIR)/%,$(BUILDDIR)/%.o,$(SOURCES))

CFLAGS		:= -mthumb -mthumb-interwork -Os -mcpu=arm946e-s+nofp -Wall -std=gnu17 \
			   -fPIE -fvisibility=hidden -ffreestanding -fno-builtin -fno-jump-tables \
			   -fno-common -fno-exceptions -fno-asynchronous-unwind-tables \
			   -ffunction-sections -fdata-sections -Icommon
LDFLAGS		:= -mcpu=arm946e-s+nofp -nostdlib -nostartfiles -static \
			   -Wl,--gc-sections,--emit-relocs,--use-blx,--no-warn-rwx-segments \
			   -T $(SOURCEDIR)/resident.ld

V := @

.PHONY: all clean FORCE

$(BUILDDIR)/config: FORCE
	@mkdir -p $(@D)
	@printf '%s\n' '$(CFLAGS)' > $@.tmp
	@cmp -s $@.tmp $@ && rm $@.tmp || mv $@.tmp $@

$(OBJS): $(BUILDDIR)/config

all: $(BIN)

$(BIN): $(ELF)
	@echo "  OBJCOPY $@"
	@mkdir -p $(@D)
	$(V)$(OBJCOPY) -O binary -j .text $< $@
	@# Only pc-relative relocations are allowed, except for the header (hook offset, totalSize)
	$(V)if $(READELF) -rW $< | grep -E "R_ARM_(ABS32|GOT)" | grep -vE "^0000000[04] "; then \
		echo "error: the resident part contains absolute relocations"; rm -f $@; exit 1; fi
	@# Interworking veneers generated by the linker use absolute addresses
	$(V)if $(NM) $< | grep -E "_from_(arm|thumb)|_veneer"; then \
		echo "error: the resident part contains interworking veneers"; rm -f $@; exit 1; fi

$(ELF): $(OBJS) $(SOURCEDIR)/resident.ld
	@echo "  LD      $@"
	$(V)$(CC) -o $@ $(OBJS) $(LDFLAGS)

$(BUILDDIR)/%.s.o: $(SOURCEDIR)/%.s
	@echo "  AS      $<"
	@mkdir -p $(@D)
	$(V)$(CC) $(CFLAGS) -c -o $@ $<

$(BUILDDIR)/%.c.o: $(SOURCEDIR)/%.c common/CheatMenuDefinitions.h arm7/source/loader/dldiHeader.h
	@echo "  CC      $<"
	@mkdir -p $(@D)
	$(V)$(CC) $(CFLAGS) -c -o $@ $<

clean:
	$(V)rm -rf $(BUILDDIR) $(BIN)
